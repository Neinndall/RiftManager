<Window x:Class="RiftManager.Dialogs.LinkSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Select Link" 
        SizeToContent="Height" Width="650"
        Background="{DynamicResource DarkBackground}" 
        Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Resources/Img/logo.ico">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Technical Header -->
            <RowDefinition Height="*"/>    <!-- Content List -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Technical Header -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" 
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="25,20">
            <StackPanel>
                <TextBlock Text="MULTIPLE CONTEXT LINKS DETECTED" Foreground="{DynamicResource AccentBrush}" 
                           FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Please select the specific comic or sub-event you want to process:" 
                           FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 2. Content List -->
        <Border Grid.Row="1" Background="{DynamicResource SidebarBackground}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                <ItemsControl Name="LinksItemsControl" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,0,12" Click="LinkButton_Click" HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource ModernButton}" MinHeight="65" Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Barra de acento -->
                                        <ColumnDefinition Width="*"/>    <!-- Info Central -->
                                    </Grid.ColumnDefinitions>

                                    <Rectangle Grid.Column="0" Width="3" Height="32" Fill="{DynamicResource AccentBrush}" 
                                               VerticalAlignment="Center" Margin="0,0,18,0" RadiusX="1.5" RadiusY="1.5"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding MetagameId}" Foreground="{DynamicResource AccentBrush}" 
                                                   FontSize="10" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                        <TextBlock Text="{Binding Url}" Foreground="{DynamicResource TextSecondary}" 
                                                   FontSize="9" Opacity="0.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 3. Footer -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackground}" 
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="20,15">
            <DockPanel LastChildFill="False">
                <TextBlock Text="RIFT MANAGER SELECTION ENGINE" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" FontSize="9" FontWeight="Bold" Opacity="0.4"/>
                <Button Content="CANCEL" Width="120" Height="36" 
                        Style="{DynamicResource ModernButton}" IsCancel="True" 
                        DockPanel.Dock="Right" FontWeight="Bold" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
