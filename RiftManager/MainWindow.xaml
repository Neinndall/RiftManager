<Window x:Class="RiftManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RiftManager"
        mc:Ignorable="d"
        Title="RiftManager" Height="760" Width="1360"
        Background="{StaticResource DarkBackground}"
        Foreground="{StaticResource TextPrimary}"
        Icon="/Resources/Img/logo.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/> <!-- Sidebar HUD -->
            <ColumnDefinition Width="*"/>   <!-- Main Area -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar (Lista de Eventos) -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}" 
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- List -->
                    <RowDefinition Height="Auto"/> <!-- Footer Técnico -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="EVENTS EXPLORER" Foreground="{StaticResource TextSecondary}" 
                           FontSize="10" FontWeight="Bold" Margin="28,20,25,12" Opacity="0.8"/>

                <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
                    <ListView Name="EventsListView" 
                              SelectionChanged="EventsListView_SelectionChanged" 
                              Style="{StaticResource ModernListViewInBorder}" 
                              Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource ModernListViewItem}">
                                <Setter Property="Padding" Value="0,8"/> <!-- Quitamos el padding lateral para que el margin mande -->
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Title}" FontSize="11" Margin="28,0,10,0"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <!-- Sidebar Footer con Versión -->
                <Border Grid.Row="2" Background="{StaticResource HeaderBackground}" Padding="20,15"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Button x:Name="RiotManifestsButton" Content="Riot Manifests" 
                                Style="{StaticResource ModernButton}" Click="DownloadRiotManifests_Click" 
                                Height="32" Margin="0,0,0,12" ToolTipService.ShowOnDisabled="True"/>
                        
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="VERSION" Foreground="{StaticResource TextSecondary}" 
                                       FontSize="9" FontWeight="Bold" Opacity="0.5" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource TextSecondary}" 
                                       FontSize="10" FontWeight="SemiBold" DockPanel.Dock="Right" 
                                       Margin="0,0,0,0" HorizontalAlignment="Right" Opacity="0.7"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Área Principal (Detalles y Log) -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Hero Panel -->
                <RowDefinition Height="*"/>    <!-- Log Panel -->
            </Grid.RowDefinitions>

            <!-- Hero Section (Evento Seleccionado) -->
            <Border x:Name="EventDetailsPanel" Grid.Row="0" CornerRadius="12" Margin="0,0,0,30" 
                    Visibility="Collapsed" Background="#2d2d30"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="240"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Banner de Imagen (Top Rounded) -->
                    <Border Grid.Row="0" CornerRadius="11,11,0,0" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush x:Name="EventBackgroundBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                        <Grid>
                            <Grid.Background>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#E6121212" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                            <StackPanel VerticalAlignment="Bottom" Margin="30">
                                <TextBlock x:Name="EventIdTextBlock" Text="EVENT_ID" Foreground="{StaticResource AccentBrush}" 
                                           FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="EventTitleTextBlock" Text="Event Title" FontSize="32" 
                                           FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Panel de Info y Acciones (Bottom Rounded) -->
                    <Border Grid.Row="1" Background="#252526" Padding="30,25" CornerRadius="0,0,11,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="TECHNICAL TYPE" Foreground="{StaticResource TextLabel}" FontSize="10" FontWeight="Bold" Width="120"/>
                                    <TextBlock x:Name="EventTypeTextBlock" Text="N/A" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="NAVIGATION ID" Foreground="{StaticResource TextLabel}" FontSize="10" FontWeight="Bold" Width="120"/>
                                    <TextBlock x:Name="EventNavIdTextBlock" Text="N/A" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="BASE URL" Foreground="{StaticResource TextLabel}" FontSize="10" FontWeight="Bold" Width="120"/>
                                    <TextBlock x:Name="EventUrlTextBlock" Text="N/A" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Medium" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel x:Name="MainLinksHeader" Visibility="Collapsed" Margin="0,15,0,0">
                                    <TextBlock Text="CONTEXT LINKS" Foreground="{StaticResource TextLabel}" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <ItemsControl x:Name="MainEventLinksList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,0,0,4" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                    <Run Text="- " Foreground="{StaticResource AccentBrush}"/>
                                                    <Run Text="{Binding Title}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                    <Run Text=" (" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                                    <Run Text="{Binding Url}" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                                    <Run Text=")" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                            <Button Name="DownloadEventButton" Grid.Column="1" Content="DOWNLOAD ASSETS" 
                                    Style="{StaticResource ModernButton}" Click="DownloadButton_Click" 
                                    Width="180" Height="44" VerticalAlignment="Top" FontWeight="Bold" FontSize="12"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Panel de Logs -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="SYSTEM ACTIVITY" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Bold" Margin="0,0,0,12" Opacity="0.8"/>
                <RichTextBox Grid.Row="1" Name="LogRichTextBox" Style="{StaticResource LogRichTextBoxStyle}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
